{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "global.d.ts",
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "eslint.config.*",
    "extension/**/*"
  ],
  "exclude": ["extension/**/__tests__/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@tomjs/vite-plugin-vscode/types"]
  }
}
